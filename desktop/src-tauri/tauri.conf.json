      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MzdFNTlCNDQ3QUNFMUUKUldRZXpucEVtK1UzQ0pUMFd3OHlQUXdWME1PK0l2aHBLZk5qSlVaZ3Ayd2szQk5UVndkVzl4RFMK",
      "endpoints": [
        "https://github.com/hanjungwoo3/portfolio-web/releases/download/apps/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
