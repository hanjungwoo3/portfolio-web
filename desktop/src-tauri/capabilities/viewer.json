{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "viewer",
  "description": "앱 안 보기 창(바깥 사이트) — '브라우저로 열기'·Esc 닫기만. native_fetch 등 다른 앱 명령은 못 부른다",
  "windows": [
    "viewer"
  ],
  "remote": {
    "urls": [
      "https://*",
      "http://*"
    ]
  },
  "permissions": [
    "allow-open-external",
    "allow-close-viewer"
  ]
}