{
  "manifest_version": 3,
  "name": "포트폴리오 시세 프록시",
  "version": "1.0.0",
  "description": "포트폴리오 앱을 팝업으로 띄우고, 시세 요청을 브라우저에서 직접 중계합니다. 가정용 IP 라 토스 과호출 차단(400)을 피하고 호출 한도가 없습니다.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://hanjungwoo3.github.io/*",
    "https://wts-info-api.tossinvest.com/*",
    "https://wts-cert-api.tossinvest.com/*",
    "https://tossinvest.com/*",
    "https://finance.naver.com/*",
    "https://m.stock.naver.com/*",
    "https://polling.finance.naver.com/*",
    "https://navercomp.wisereport.co.kr/*",
    "https://api.investing.com/*",
    "https://yasun.gg/*",
    "https://scanner.tradingview.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "포트폴리오 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hanjungwoo3.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}