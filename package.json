{
  "name": "portfolio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node workers/local-proxy/server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "git push origin main && gh-pages -d dist -b gh-pages",
    "pack:extension": "node scripts/pack-extension.mjs",
    "gen-names": "node scripts/gen-stock-names.mjs",
    "gen-etf-weights": "node scripts/gen-etf-weights.mjs",
    "build:android": "BUILD_TARGET=native vite build && rm -rf dist/app && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "pack:app": "node scripts/pack-app.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@tanstack/react-query": "^5.100.5",
    "dexie": "^4.4.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0"
  }
}
